# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Local research scratch
scratch/
*.tmp

# Generated complex-project fixture checkouts (materialized locally; do not commit)
sources/evaluations/fixtures/large/*/repo/
sources/evaluations/fixtures/medium/*/repo/
sources/evaluations/workflow-sessions/*/project/
sources/evaluations/workflow-sessions/*/codex-homes/

# Generated evaluation run outputs and old per-profile planned-run matrices.
# Current workflow runs are defined by data/workflow-task-sequences.json; keep
# compact workflow-session evidence bundles only.
sources/evaluations/fixtures/large/*/runs/*/
sources/evaluations/fixtures/medium/*/runs/*/
sources/evaluations/workflow-sessions/*/
!sources/evaluations/workflow-sessions/*/
sources/evaluations/workflow-sessions/*/*
!sources/evaluations/workflow-sessions/*/run.json
!sources/evaluations/workflow-sessions/*/changes.diff
!sources/evaluations/workflow-sessions/*/evidence.jsonl.gz
!sources/evaluations/workflow-sessions/*/manifest.sha256

# OS/editor
.DS_Store
.vscode/
.idea/
