{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/token-optimization/workflow-session-record.schema.json",
  "title": "Token optimization workflow session record",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "record_type",
    "evidence_type",
    "study_id",
    "experiment_group_id",
    "objective",
    "evidence_stage",
    "status",
    "session_role",
    "replicate_index",
    "date",
    "target",
    "task_sequence",
    "profile",
    "agent",
    "state_policy",
    "cumulative_token_usage",
    "per_task_results",
    "software_quality",
    "state_observations",
    "operational_reproducibility",
    "artifacts",
    "interpretation"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "session_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "record_type": { "const": "workflow_session" },
    "evidence_type": {
      "enum": ["workflow-simulation", "workflow-ablation", "sanity-check"]
    },
    "study_id": { "type": "string" },
    "experiment_group_id": { "type": "string" },
    "objective": {
      "enum": ["individual_tool_effectiveness", "stack_effectiveness"]
    },
    "evidence_stage": {
      "enum": ["benchmark_audit", "reproduction"]
    },
    "status": {
      "enum": ["planned", "running", "completed", "failed", "excluded", "superseded"]
    },
    "session_role": {
      "enum": ["baseline", "individual_tool_treatment", "stack_treatment", "ablation", "sanity_check"]
    },
    "replicate_index": { "type": "integer", "minimum": 0 },
    "baseline_pool": {
      "type": "object",
      "required": ["protocol_version", "protocol_fingerprint", "identity_policy"],
      "properties": {
        "protocol_version": { "type": "string" },
        "protocol_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
        "identity_policy": { "const": "frozen-protocol-and-replicate; execution date is metadata only" }
      }
    },
    "frozen_protocol": {
      "type": "object",
      "required": ["protocol_id", "path", "sha256"],
      "properties": {
        "protocol_id": { "type": "string" },
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "selected_execution": {
      "type": "object",
      "required": ["descriptor_sha256", "descriptor"],
      "properties": {
        "descriptor_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "descriptor": { "type": "object" }
      }
    },
    "docker_image_identity": {
      "type": "object",
      "required": ["image_ref", "image_id", "repo_digests"],
      "properties": {
        "image_ref": { "type": "string" },
        "image_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "repo_digests": { "type": "array", "items": { "type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$" } },
        "repo_tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tool_adapter_identity": {
      "type": ["object", "null"],
      "properties": {
        "tool_id": { "type": ["string", "null"] },
        "tool_manifest": { "type": "string" },
        "tool_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "tool_config": { "type": ["object", "null"] },
        "tool_config_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "tool_state": { "type": "string" },
        "tool_use_policy": { "type": "string" },
        "command_identity": {
          "type": "object",
          "required": ["kind", "command"],
          "properties": {
            "kind": { "type": "string" },
            "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          }
        },
        "binary_identity": {
          "type": ["object", "null"],
          "required": ["executable_token", "resolved_path", "realpath", "sha256", "metadata", "version"],
          "properties": {
            "executable_token": { "type": "string" },
            "resolved_path": { "type": "string" },
            "realpath": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "metadata": {
              "type": "object",
              "required": ["size", "mode", "uid", "gid", "mtime_ns"],
              "properties": {
                "size": { "type": "integer", "minimum": 0 },
                "mode": { "type": "string" },
                "uid": { "type": "integer" },
                "gid": { "type": "integer" },
                "mtime_ns": { "type": "integer" }
              }
            },
            "version": {
              "type": "object",
              "required": ["command", "captured"],
              "properties": {
                "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "captured": { "type": "boolean" },
                "exit_code": { "type": "integer" },
                "output": { "type": "string" },
                "truncated": { "type": "boolean" },
                "error": { "type": "string" }
              }
            }
          }
        },
        "source_identity": { "type": "array", "items": { "type": "object" } }
      }
    },
    "date": { "type": "string" },
    "target": {
      "type": "object",
      "required": ["fixture_id", "fixture_scale", "project_id", "repository_path", "initial_snapshot"],
      "properties": {
        "fixture_id": { "type": "string" },
        "fixture_scale": {
          "enum": ["synthetic-micro", "recorded-diagnostic", "medium-project", "large-project"]
        },
        "project_id": { "type": "string" },
        "repository_path": { "type": "string" },
        "initial_snapshot": { "type": "object" }
      }
    },
    "task_sequence": {
      "type": "object",
      "required": ["sequence_id", "task_ids", "reset_policy"],
      "properties": {
        "sequence_id": { "type": "string" },
        "task_ids": { "type": "array", "items": { "type": "string" } },
        "reset_policy": { "type": "string" },
        "prompt_delivery": {
          "type": "object",
          "required": ["mode", "future_tasks_visible", "future_prompts_materialized_lazily"],
          "properties": {
            "mode": { "const": "sequential-one-task-at-a-time" },
            "future_tasks_visible": { "type": "boolean" },
            "future_prompts_materialized_lazily": { "type": "boolean" },
            "seed_delivery_mode": { "enum": ["lazy-one-task-at-a-time", "all-seeds-before-task-1"] },
            "future_seed_regressions_visible": { "type": "boolean" }
          }
        },
        "leakage_controls": {
          "type": "object",
          "required": ["seed_origin_concealed", "task_directories_model_visible", "verifier_assets_model_visible", "verifier_integrity_passed"],
          "properties": {
            "seed_origin_concealed": { "type": "boolean" },
            "seed_patches_model_visible": { "type": "boolean" },
            "git_baseline_true_root_per_task": { "type": "boolean" },
            "fixed_snapshot_objects_model_visible": { "type": "boolean" },
            "pre_seed_reflog_entries_visible": { "type": "boolean" },
            "concealment_verification_passed": { "type": "boolean" },
            "task_directories_model_visible": { "type": "boolean" },
            "verifier_assets_model_visible": { "type": "boolean" },
            "verifier_integrity_passed": { "type": ["boolean", "null"] }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "required": ["profile_id", "profile_type", "enabled_surfaces", "disabled_overlaps", "component_ids"],
      "properties": {
        "profile_id": { "type": "string" },
        "profile_type": { "type": "string" },
        "enabled_surfaces": { "type": "array", "items": { "type": "string" } },
        "disabled_overlaps": { "type": "array", "items": { "type": "string" } },
        "component_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "agent": {
      "type": "object",
      "required": ["runtime_id", "model_condition_id", "name", "version", "model", "provider", "reasoning_effort", "temperature", "max_turns", "time_budget_seconds"],
      "properties": {
        "runtime_id": { "type": "string" },
        "model_condition_id": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "model": { "type": "string" },
        "provider": { "type": "string" },
        "reasoning_effort": { "type": ["string", "null"] },
        "temperature": { "type": ["string", "number", "null"] },
        "max_turns": { "type": ["integer", "null"], "minimum": 0 },
        "time_budget_seconds": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "state_policy": {
      "type": "object",
      "required": ["reset_before_session", "persist_between_tasks"],
      "properties": {
        "reset_before_session": { "type": "array", "items": { "type": "string" } },
        "persist_between_tasks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cumulative_token_usage": {
      "type": "object",
      "required": ["measurement_source", "total_provider_tokens", "pricing_basis"],
      "properties": {
        "measurement_source": { "type": "string" },
        "fresh_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_write_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_provider_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "tokens_per_accepted_task": { "type": ["number", "null"], "minimum": 0 },
        "pricing_basis": { "type": "string" }
      }
    },
    "per_task_results": { "type": "array", "items": { "type": "object" } },
    "software_quality": {
      "type": "object",
      "required": ["functional_verifier_passed", "quality_review_status", "quality_score", "critical_failures"],
      "properties": {
        "functional_verifier_passed": { "type": "boolean" },
        "quality_review_status": { "enum": ["not-reviewed", "reviewed"] },
        "quality_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 },
        "critical_failures": { "type": "array", "items": { "type": "string" } }
      }
    },
    "state_observations": { "type": "object" },
    "operational_reproducibility": { "type": "object" },
    "artifacts": { "type": "object" },
    "interpretation": {
      "type": "object",
      "required": ["accepted_for_execution", "accepted_for_objective", "claim_status", "exclusion_reason"],
      "properties": {
        "accepted_for_execution": { "type": "boolean" },
        "accepted_for_objective": { "type": "boolean" },
        "claim_status": { "type": "string" },
        "exclusion_reason": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "frozen_protocol": {
            "properties": {
              "protocol_id": { "pattern": "-v3$" }
            },
            "required": ["protocol_id"]
          }
        },
        "required": ["frozen_protocol"]
      },
      "then": {
        "required": ["frozen_protocol", "selected_execution", "docker_image_identity", "tool_adapter_identity"]
      }
    }
  ]
}
