{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/token-optimization/workflow-session-record.schema.json",
  "title": "Token optimization workflow session record",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "record_type",
    "evidence_type",
    "study_id",
    "experiment_group_id",
    "objective",
    "evidence_stage",
    "status",
    "session_role",
    "replicate_index",
    "date",
    "target",
    "task_sequence",
    "profile",
    "agent",
    "state_policy",
    "cumulative_token_usage",
    "per_task_results",
    "software_quality",
    "artifacts",
    "interpretation"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "record_type": {
      "const": "workflow_session"
    },
    "evidence_type": {
      "enum": [
        "workflow-simulation",
        "workflow-ablation",
        "sanity-check"
      ]
    },
    "study_id": {
      "type": "string"
    },
    "experiment_group_id": {
      "type": "string"
    },
    "objective": {
      "enum": [
        "individual_tool_effectiveness",
        "stack_effectiveness"
      ]
    },
    "evidence_stage": {
      "enum": [
        "benchmark_audit",
        "reproduction"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "running",
        "completed",
        "failed",
        "excluded",
        "superseded"
      ]
    },
    "session_role": {
      "enum": [
        "baseline",
        "individual_tool_treatment",
        "stack_treatment",
        "replacement_runtime",
        "ablation",
        "sanity_check"
      ]
    },
    "replicate_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Runtime-local immutable attempt label. Do not use it to pair different runtimes unless interpretation.comparison_pair explicitly binds accepted-replicate ordinals."
    },
    "baseline_pool": {
      "type": "object",
      "required": [
        "protocol_version",
        "protocol_fingerprint",
        "identity_policy"
      ],
      "properties": {
        "protocol_version": {
          "type": "string"
        },
        "protocol_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{12}$"
        },
        "identity_policy": {
          "const": "frozen-protocol-and-replicate; execution date is metadata only"
        }
      }
    },
    "frozen_protocol": {
      "type": "object",
      "required": [
        "protocol_id",
        "path",
        "sha256"
      ],
      "properties": {
        "protocol_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "selected_execution": {
      "type": "object",
      "required": [
        "descriptor_sha256",
        "descriptor"
      ],
      "properties": {
        "descriptor_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "descriptor": {
          "type": "object"
        }
      }
    },
    "docker_image_identity": {
      "type": "object",
      "required": [
        "image_ref",
        "image_id",
        "repo_digests"
      ],
      "properties": {
        "image_ref": {
          "type": "string"
        },
        "image_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "repo_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^.+@sha256:[a-f0-9]{64}$"
          }
        },
        "repo_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tool_adapter_identity": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "tool_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_manifest": {
          "type": "string"
        },
        "tool_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tool_config": {
          "type": [
            "object",
            "null"
          ]
        },
        "tool_config_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tool_state": {
          "type": "string"
        },
        "tool_use_policy": {
          "type": "string"
        },
        "command_identity": {
          "type": "object",
          "required": [
            "kind",
            "command"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          }
        },
        "binary_identity": {
          "type": [
            "object",
            "null"
          ],
          "description": "Either a pinned executable identity or, when the host integration generates the adapter, the install contract that produced it.",
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "generated-by-host-integration"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "required": [
                  "kind",
                  "command_template",
                  "install_commands",
                  "install_contract_sha256"
                ]
              },
              "else": {
                "required": [
                  "executable_token",
                  "resolved_path",
                  "realpath",
                  "sha256",
                  "metadata",
                  "version"
                ]
              }
            }
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "command_template": {
              "type": "string",
              "minLength": 1
            },
            "install_commands": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "install_contract_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "executable_token": {
              "type": "string"
            },
            "resolved_path": {
              "type": "string"
            },
            "realpath": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "metadata": {
              "type": "object",
              "required": [
                "size",
                "mode",
                "uid",
                "gid",
                "mtime_ns"
              ],
              "properties": {
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "mode": {
                  "type": "string"
                },
                "uid": {
                  "type": "integer"
                },
                "gid": {
                  "type": "integer"
                },
                "mtime_ns": {
                  "type": "integer"
                }
              }
            },
            "version": {
              "type": "object",
              "required": [
                "command",
                "captured"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "captured": {
                  "type": "boolean"
                },
                "exit_code": {
                  "type": "integer"
                },
                "output": {
                  "type": "string"
                },
                "truncated": {
                  "type": "boolean"
                },
                "error": {
                  "type": "string"
                }
              }
            }
          }
        },
        "source_identity": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "date": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "required": [
        "fixture_id",
        "fixture_scale",
        "project_id",
        "repository_path",
        "initial_snapshot"
      ],
      "properties": {
        "fixture_id": {
          "type": "string"
        },
        "fixture_scale": {
          "enum": [
            "synthetic-micro",
            "recorded-diagnostic",
            "medium-project",
            "large-project"
          ]
        },
        "project_id": {
          "type": "string"
        },
        "repository_path": {
          "type": "string"
        },
        "initial_snapshot": {
          "type": "object"
        }
      }
    },
    "task_sequence": {
      "type": "object",
      "required": [
        "sequence_id",
        "task_ids",
        "reset_policy",
        "prompt_delivery",
        "leakage_controls"
      ],
      "properties": {
        "sequence_id": {
          "type": "string"
        },
        "sequence_contract": {
          "type": "string"
        },
        "task_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "task_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reset_policy": {
          "type": "string"
        },
        "prompt_delivery": {
          "type": "object",
          "required": [
            "mode",
            "future_tasks_visible",
            "future_prompts_materialized_lazily",
            "seed_delivery_mode",
            "future_seed_regressions_visible"
          ],
          "properties": {
            "mode": {
              "const": "sequential-one-task-at-a-time"
            },
            "future_tasks_visible": {
              "type": "boolean"
            },
            "future_prompts_materialized_lazily": {
              "type": "boolean"
            },
            "seed_delivery_mode": {
              "const": "preseeded-composite"
            },
            "future_seed_regressions_visible": {
              "type": "boolean"
            },
            "controller_verification": {
              "const": "final-only"
            }
          }
        },
        "leakage_controls": {
          "type": "object",
          "required": [
            "seed_origin_concealed",
            "seed_patches_model_visible",
            "fixed_snapshot_objects_model_visible",
            "pre_seed_reflog_entries_visible",
            "concealment_verification_passed",
            "task_directories_model_visible",
            "verifier_integrity_passed"
          ],
          "properties": {
            "seed_origin_concealed": {
              "type": "boolean"
            },
            "seed_patches_model_visible": {
              "type": "boolean"
            },
            "git_baseline_true_root_at_lane_start": {
              "type": "boolean"
            },
            "fixed_snapshot_objects_model_visible": {
              "type": "boolean"
            },
            "pre_seed_reflog_entries_visible": {
              "type": "boolean"
            },
            "concealment_verification_passed": {
              "type": "boolean"
            },
            "task_directories_model_visible": {
              "type": "boolean"
            },
            "verifier_assets_model_visible": {
              "type": "boolean"
            },
            "controller_verifier_scripts_and_canonical_copies_model_visible": {
              "type": "boolean"
            },
            "model_visible_acceptance_asset_paths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "verifier_integrity_passed": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "anyOf": [
            {
              "required": [
                "verifier_assets_model_visible"
              ]
            },
            {
              "required": [
                "controller_verifier_scripts_and_canonical_copies_model_visible",
                "model_visible_acceptance_asset_paths"
              ]
            }
          ]
        }
      },
      "allOf": [
        {
          "properties": {
            "prompt_delivery": {
              "required": [
                "controller_verification"
              ],
              "properties": {
                "seed_delivery_mode": {
                  "const": "preseeded-composite"
                },
                "future_seed_regressions_visible": {
                  "const": true
                },
                "controller_verification": {
                  "const": "final-only"
                }
              }
            },
            "leakage_controls": {
              "required": [
                "git_baseline_true_root_at_lane_start"
              ],
              "properties": {
                "git_baseline_true_root_at_lane_start": {
                  "const": true
                }
              }
            }
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "required": [
        "profile_id",
        "profile_type",
        "enabled_surfaces",
        "disabled_overlaps",
        "component_ids"
      ],
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "profile_type": {
          "type": "string"
        },
        "enabled_surfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disabled_overlaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "component_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "required": [
        "runtime_id",
        "model_condition_id",
        "name",
        "version",
        "model",
        "provider",
        "reasoning_effort",
        "temperature",
        "max_turns",
        "time_budget_seconds"
      ],
      "properties": {
        "runtime_id": {
          "type": "string"
        },
        "model_condition_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "temperature": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "max_turns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "time_budget_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "state_policy": {
      "type": "object",
      "required": [
        "reset_before_session",
        "persist_between_tasks"
      ],
      "properties": {
        "reset_before_session": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "persist_between_tasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cumulative_token_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_source",
        "weighted_token_cost",
        "weighted_token_cost_formula"
      ],
      "properties": {
        "measurement_source": {
          "type": "string"
        },
        "fresh_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_write_tokens": {
          "description": "Null is retained only for immutable legacy records; current accepted/reusable contracts require an exact non-negative integer in repository and runtime validation.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_provider_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "weighted_token_cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "weighted_token_cost_formula": {
          "const": "fresh_input_tokens + 0.1 * cached_input_tokens + 6 * output_tokens"
        },
        "provider_usage_details": {
          "description": "Lossless normalized provider token-bearing fields and accounting provenance. Cache-write tokens are retained here and as cache_write_tokens, but are already included in fresh_input_tokens.",
          "type": [
            "object",
            "null"
          ]
        },
        "accounting_basis": {
          "type": "string"
        }
      }
    },
    "per_task_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "task_class": {
            "type": "string"
          },
          "task_alias": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "agent_attempted": {
            "type": "boolean"
          },
          "codex_exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "controller_verification": {
            "enum": [
              "deferred-to-final",
              "passed",
              "failed",
              "not-run"
            ]
          },
          "verifier_exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "verifier_passed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "accepted": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "operational_retry_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "software_quality": {
      "type": "object",
      "required": [
        "functional_verifier_passed",
        "quality_review_status",
        "quality_score",
        "critical_failures"
      ],
      "properties": {
        "tasks_attempted": {
          "type": "integer",
          "minimum": 0
        },
        "tasks_passed": {
          "type": "integer",
          "minimum": 0
        },
        "final_verifier_passed": {
          "type": "boolean"
        },
        "functional_verifier_passed": {
          "type": "boolean"
        },
        "quality_review_status": {
          "enum": [
            "not-reviewed",
            "reviewed"
          ]
        },
        "quality_score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },
        "critical_failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "state_observations": {
      "type": "object"
    },
    "operational_reproducibility": {
      "type": "object"
    },
    "execution_integrity": {
      "type": "object",
      "properties": {
        "verifier_integrity_passed": {
          "type": "boolean"
        },
        "tool_isolation_audit_passed": {
          "type": "boolean"
        },
        "external_retrieval_hits": {
          "type": "array"
        },
        "pass_through_tool_command_hits": {
          "type": "array"
        }
      }
    },
    "artifacts": {
      "type": "object"
    },
    "interpretation": {
      "type": "object",
      "required": [
        "accepted_for_execution",
        "accepted_for_objective",
        "claim_status",
        "exclusion_reason"
      ],
      "properties": {
        "accepted_for_execution": {
          "type": "boolean"
        },
        "accepted_for_objective": {
          "type": "boolean"
        },
        "claim_status": {
          "type": "string"
        },
        "exclusion_reason": {
          "type": "string"
        },
        "comparison_baseline_session_id": {
          "type": "string"
        },
        "comparison_pair": {
          "type": "object",
          "required": [
            "id",
            "basis",
            "accepted_replicate_ordinal",
            "treatment_runtime_replicate_index",
            "baseline_runtime_replicate_index"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "basis": {
              "const": "accepted-replicate-ordinal"
            },
            "accepted_replicate_ordinal": {
              "type": "integer",
              "minimum": 1
            },
            "treatment_runtime_replicate_index": {
              "type": "integer",
              "minimum": 0
            },
            "baseline_runtime_replicate_index": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "sample_plan": {
      "type": "object",
      "description": "Pre-registered sample this replicate belongs to. Registered before the first provider call so a median cannot be assembled by rerunning until the number is favourable (ADR 0007).",
      "required": [
        "plan_id",
        "planned_replicates",
        "registered_on",
        "estimator"
      ],
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "planned_replicates": {
          "type": "integer",
          "minimum": 3,
          "description": "N, odd and at least 3. Enforced odd by validate_repository."
        },
        "registered_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "estimator": {
          "const": "median-weighted-token-cost"
        },
        "supersedes_plan_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Set when a sample was extended after results were seen; both estimates are reported."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "execution_integrity",
          "frozen_protocol",
          "selected_execution",
          "docker_image_identity",
          "tool_adapter_identity",
          "sample_plan"
        ],
        "properties": {
          "task_sequence": {
            "required": [
              "task_ids"
            ]
          },
          "per_task_results": {
            "minItems": 1,
            "items": {
              "required": [
                "task_id",
                "task_alias",
                "order",
                "agent_attempted",
                "codex_exit_code",
                "controller_verification",
                "verifier_exit_code",
                "verifier_passed",
                "accepted",
                "operational_retry_count"
              ]
            }
          },
          "software_quality": {
            "required": [
              "tasks_attempted",
              "tasks_passed",
              "final_verifier_passed",
              "functional_verifier_passed",
              "quality_review_status",
              "quality_score",
              "critical_failures"
            ]
          },
          "cumulative_token_usage": {
            "required": [
              "accounting_basis"
            ]
          },
          "execution_integrity": {
            "required": [
              "verifier_integrity_passed",
              "tool_isolation_audit_passed",
              "external_retrieval_hits",
              "pass_through_tool_command_hits"
            ]
          }
        }
      }
    },
    {
      "if": {
