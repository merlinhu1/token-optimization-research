+function setupHandlerTimeout (req, request, reply, context) {
+  if (context.handlerTimeout === 0) {
+    return false
+  }
+
+  const ac = new AbortController()
+  const timeout = context.handlerTimeout
+  request[kRequestSignal] = ac
+  request[kTimeoutTimer] = setTimeout(() => {
+    if (!reply.sent) {
+      const err = new FST_ERR_HANDLER_TIMEOUT(timeout, context.config?.url)
+      ac.abort(err)
+      reply[kReplyIsError] = true
+      reply.send(err)
+    }
+  }, timeout)
+
+  request[kOnAbort] = () => {
+    if (!ac.signal.aborted) {
+      ac.abort()
+    }
+    clearTimeout(request[kTimeoutTimer])
+    request[kTimeoutTimer] = null
+    req.removeListener('close', request[kOnAbort])
+    request[kOnAbort] = null
+  }
+  req.on('close', request[kOnAbort])
+  return true
+}
+
+function validateHandlerTimeoutOption (handlerTimeout) {
+  if (handlerTimeout === undefined) return
+  if (!Number.isInteger(handlerTimeout) || handlerTimeout <= 0) {
+    throw new FST_ERR_ROUTE_HANDLER_TIMEOUT_OPTION_NOT_INT(handlerTimeout)
+  }
+}
