+if TYPE_CHECKING:
+    from collections.abc import Mapping
+
+
+ModifyOperator = Literal["+", "-"]
+
+
+@dataclass(frozen=True)
+class ModifyOperation:
+    """A command-line field assignment and its optional list operation."""
+
+    operator: ModifyOperator | None
+    value: str
+
+
+@dataclass(frozen=True)
+class ParsedModifyOperation:
+    """A modify operation whose value has been parsed for a model field."""
+
+    operator: ModifyOperator | None
+    value: object
+
+
+def _is_multi_value_field(model_cls, field: str) -> bool:
+    """Return whether ``field`` is represented by a list-valued type."""
+    return model_cls._type(field).model_type is list
+
+
+def _validate_operations(model_cls, mods: Mapping[str, ModifyOperation]) -> None:
+    """Reject incremental operations for fields that are not list-valued."""
+    for field, operation in mods.items():
+        if operation.operator is not None and not _is_multi_value_field(
+            model_cls, field
+        ):
+            raise UserError(
+                f"field {field!r} does not support the {operation.operator}= "
+                "operator"
+            )
+
+
+def _parse_operations(
+    model_cls,
+    obj,
+    mods: Mapping[str, ModifyOperation],
+    templates: Mapping[str, functemplate.Template],
+) -> dict[str, ParsedModifyOperation]:
+    """Evaluate templates and parse each assignment for ``obj``."""
+    return {
+        field: ParsedModifyOperation(
+            operation.operator,
+            model_cls._parse(
+                field, obj.evaluate_template(templates[field])
+            ),
+        )
+        for field, operation in mods.items()
+    }
+
+
+def _apply_operations(obj, mods: Mapping[str, ParsedModifyOperation]) -> None:
+    """Apply parsed assignments, including list additions and removals."""
+    values: dict[str, object] = {}
+    for field, operation in mods.items():
+        if operation.operator is None:
+            values[field] = operation.value
+            continue
+
+        current = list(cast(list[object], obj.get(field, [])))
+        parsed_values = cast(list[object], operation.value)
+        if operation.operator == "+":
+            for value in parsed_values:
+                if value not in current:
+                    current.append(value)
+        else:
+            current = [value for value in current if value not in parsed_values]
+        values[field] = current
+
+    obj.update(values)
+
 
