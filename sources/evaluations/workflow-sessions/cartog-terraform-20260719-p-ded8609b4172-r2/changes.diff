+// listTFPolicyEvaluationOutcomes follows the pagination returned by the
+// outcomes endpoint. A single Terraform policy evaluation can have enough
+// policy sets to span multiple pages.
+func (b *Cloud) listTFPolicyEvaluationOutcomes(ctx context.Context, evaluationID string) ([]*tfe.TFPolicySetOutcome, error) {
+	options := &tfe.TFPolicyEvaluationListOptions{}
+	var outcomes []*tfe.TFPolicySetOutcome
+
+	for {
+		page, err := b.client.TFPolicyEvaluationOutcomes.List(ctx, evaluationID, options)
+		if err != nil {
+			return nil, err
+		}
+		if page == nil {
+			return outcomes, nil
+		}
+
+		outcomes = append(outcomes, page.Items...)
+		if page.Pagination == nil || page.CurrentPage >= page.TotalPages {
+			return outcomes, nil
+		}
+
+		nextPage := page.NextPage
+		// Be defensive about incomplete pagination metadata. The normal API
+		// response supplies NextPage, but advancing by one is preferable to
+		// silently dropping pages if it does not.
+		if nextPage <= page.CurrentPage {
+			nextPage = page.CurrentPage + 1
+		}
+		if nextPage > page.TotalPages {
+			return outcomes, nil
+		}
+		options.PageNumber = nextPage
+	}
+}
+
+func nonEmptyTFPolicySetOutcomes(sets []*tfe.TFPolicySetOutcome) []*tfe.TFPolicySetOutcome {
+	result := make([]*tfe.TFPolicySetOutcome, 0, len(sets))
+	for _, set := range sets {
+		if set == nil {
+			continue
+		}
+		for _, outcome := range set.Outcomes {
+			if outcome != nil {
+				result = append(result, set)
+				break
+			}
+		}
+	}
+	return result
+}
+
+func isUnsupportedTFPolicyInclude(err error) bool {
+	if errors.Is(err, tfe.ErrInvalidIncludeValue) {
+		return true
+	}
+	message := strings.ToLower(err.Error())
+	if strings.Contains(message, "invalid include parameter") {
+		return true
+	}
+	return strings.Contains(message, "include") &&
+		(strings.Contains(message, "invalid") || strings.Contains(message, "unsupported") || strings.Contains(message, "unknown"))
+}
