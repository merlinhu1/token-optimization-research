+// listTFPolicySetOutcomes collects all pages for one evaluation. The API's
+// default page size is intentionally used here; setting a larger size would
+// make this output depend on a server-specific maximum.
+func (b *Cloud) listTFPolicySetOutcomes(ctx context.Context, evaluationID string) ([]*tfe.TFPolicySetOutcome, error) {
+	var outcomes []*tfe.TFPolicySetOutcome
+	var options *tfe.TFPolicyEvaluationListOptions
+	requestedPage := 0
+
+	for {
+		page, err := b.client.TFPolicyEvaluationOutcomes.List(ctx, evaluationID, options)
+		if err != nil {
+			return nil, err
+		}
+		if page == nil {
+			return outcomes, nil
+		}
+		outcomes = append(outcomes, page.Items...)
+
+		if page.Pagination == nil || page.NextPage == 0 {
+			return outcomes, nil
+		}
+
+		currentPage := page.CurrentPage
+		if currentPage == 0 {
+			currentPage = requestedPage
+			if currentPage == 0 {
+				currentPage = 1
+			}
+		}
+		// Treat a repeated or backwards page number as the end of the result
+		// set. This also accommodates older mock/API responses that report the
+		// current page as their next page on a single-page result.
+		if page.NextPage <= currentPage {
+			return outcomes, nil
+		}
+
+		requestedPage = page.NextPage
+		options = &tfe.TFPolicyEvaluationListOptions{
+			ListOptions: tfe.ListOptions{PageNumber: requestedPage},
+		}
+	}
+}
