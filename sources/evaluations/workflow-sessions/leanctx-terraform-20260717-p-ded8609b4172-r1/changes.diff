+// readTFPolicyEvaluationOutcomes reads all policy-set outcome pages for one
+// evaluation. A separate request is required for each page because the run
+// include only provides the evaluation metadata.
+func (b *Cloud) readTFPolicyEvaluationOutcomes(ctx context.Context, evaluationID string) ([]*tfe.TFPolicySetOutcome, error) {
+	options := &tfe.TFPolicyEvaluationListOptions{}
+	var outcomes []*tfe.TFPolicySetOutcome
+
+	for {
+		page, err := b.client.TFPolicyEvaluationOutcomes.List(ctx, evaluationID, options)
+		if err != nil {
+			return nil, err
+		}
+		if page == nil {
+			return outcomes, nil
+		}
+
+		outcomes = append(outcomes, page.Items...)
+		if page.Pagination == nil || page.CurrentPage >= page.TotalPages {
+			return outcomes, nil
+		}
+
+		nextPage := page.NextPage
+		if nextPage <= page.CurrentPage {
+			nextPage = page.CurrentPage + 1
+		}
+		options.PageNumber = nextPage
+	}
+}
