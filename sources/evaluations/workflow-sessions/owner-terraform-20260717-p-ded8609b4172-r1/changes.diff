+// tfPolicyEvaluationOutcomes returns all of the policy-set outcomes for an
+// evaluation. The API paginates this endpoint, even though most evaluations
+// have only one page of results.
+func (b *Cloud) tfPolicyEvaluationOutcomes(ctx context.Context, evaluationID string) ([]*tfe.TFPolicySetOutcome, error) {
+	var outcomes []*tfe.TFPolicySetOutcome
+	options := &tfe.TFPolicyEvaluationListOptions{}
+
+	for {
+		page, err := b.client.TFPolicyEvaluationOutcomes.List(ctx, evaluationID, options)
+		if err != nil {
+			return nil, err
+		}
+		if page == nil {
+			break
+		}
+
+		outcomes = append(outcomes, page.Items...)
+		if page.Pagination == nil {
+			break
+		}
+		if page.TotalPages > 0 && page.CurrentPage >= page.TotalPages {
+			break
+		}
+
+		nextPage := page.NextPage
+		if nextPage == 0 && page.CurrentPage > 0 && page.TotalPages > page.CurrentPage {
+			nextPage = page.CurrentPage + 1
+		}
+		if nextPage == 0 || nextPage == options.PageNumber || nextPage == page.CurrentPage {
+			break
+		}
+		options.PageNumber = nextPage
+	}
+
+	return outcomes, nil
+}
