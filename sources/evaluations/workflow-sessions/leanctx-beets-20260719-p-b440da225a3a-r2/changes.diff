+ModifyOperator = Literal["+=", "-="]
+
+
+@dataclass(frozen=True)
+class ModifyOperation:
+    """A parsed assignment for the ``modify`` command."""
+
+    operator: ModifyOperator | None
+    value: str
+
+
+def _validate_modifications(
+    model_cls: type[library.LibModel], mods: Mapping[str, ModifyOperation]
+) -> None:
+    """Ensure incremental operations target fields represented as lists."""
+    for field, modification in mods.items():
+        if (
+            modification.operator is not None
+            and model_cls._type(field).model_type is not list
+        ):
+            raise UserError(
+                f"field '{field}' does not support operator "
+                f"'{modification.operator}'"
+            )
+
+
+def _apply_operation(
+    obj: library.LibModel, field: str, modification: ModifyOperation, value: Any
+) -> Any:
+    """Apply one parsed assignment to an object's current field value."""
+    if modification.operator is None:
+        return value
+
+    current = obj[field]
+    if not isinstance(current, list) or not isinstance(value, list):
+        # This should be prevented by `_validate_modifications`, but keeping
+        # the guard here makes this helper safe for direct callers too.
+        raise UserError(
+            f"field '{field}' does not support operator "
+            f"'{modification.operator}'"
+        )
+
+    if modification.operator == "+=":
+        result = list(current)
+        for item in value:
+            if item not in result:
+                result.append(item)
+        return result
+
+    if modification.operator == "-=":
+        return [item for item in current if item not in value]
+
+    raise ValueError(f"unknown modify operator {modification.operator!r}")
+
