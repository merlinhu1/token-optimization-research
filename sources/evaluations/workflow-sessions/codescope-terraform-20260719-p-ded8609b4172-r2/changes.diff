+// listTFPolicyEvaluationOutcomes fetches all pages for one evaluation.
+func (b *Cloud) listTFPolicyEvaluationOutcomes(ctx context.Context, evaluationID string) ([]*tfe.TFPolicySetOutcome, error) {
+	var outcomes []*tfe.TFPolicySetOutcome
+	options := &tfe.TFPolicyEvaluationListOptions{}
+
+	for {
+		page, err := b.client.TFPolicyEvaluationOutcomes.List(ctx, evaluationID, options)
+		if err != nil {
+			return nil, err
+		}
+		if page == nil {
+			return outcomes, nil
+		}
+
+		outcomes = append(outcomes, page.Items...)
+		if page.Pagination == nil {
+			return outcomes, nil
+		}
+
+		nextPage := page.Pagination.NextPage
+		if nextPage <= 0 && page.Pagination.TotalPages > page.Pagination.CurrentPage {
+			nextPage = page.Pagination.CurrentPage + 1
+		}
+		if nextPage <= 0 || nextPage == options.PageNumber {
+			return outcomes, nil
+		}
+		options.PageNumber = nextPage
+	}
+}
