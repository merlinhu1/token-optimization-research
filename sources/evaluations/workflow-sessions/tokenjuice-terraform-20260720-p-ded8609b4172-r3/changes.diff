+// listTFPolicyEvaluationOutcomes reads all pages for one evaluation. The
+// policy-set outcomes endpoint uses the standard TFE page-number pagination.
+func (b *Cloud) listTFPolicyEvaluationOutcomes(ctx context.Context, evaluationID string) ([]*tfe.TFPolicySetOutcome, error) {
+	var ret []*tfe.TFPolicySetOutcome
+	options := (*tfe.TFPolicyEvaluationListOptions)(nil)
+
+	for {
+		page, err := b.client.TFPolicyEvaluationOutcomes.List(ctx, evaluationID, options)
+		if err != nil {
+			return nil, err
+		}
+		if page == nil {
+			return ret, nil
+		}
+
+		ret = append(ret, page.Items...)
+		if page.Pagination == nil || page.NextPage == 0 {
+			return ret, nil
+		}
+
+		options = &tfe.TFPolicyEvaluationListOptions{
+			ListOptions: tfe.ListOptions{PageNumber: page.NextPage},
+		}
+	}
+}
