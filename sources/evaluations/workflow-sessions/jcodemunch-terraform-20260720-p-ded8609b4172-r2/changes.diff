+// listTFPolicyEvaluationOutcomes retrieves every page of policy-set outcomes
+// for an evaluation. The TFE client does not automatically follow pagination
+// for this endpoint.
+func (b *Cloud) listTFPolicyEvaluationOutcomes(ctx context.Context, evaluationID string) ([]*tfe.TFPolicySetOutcome, error) {
+	var options *tfe.TFPolicyEvaluationListOptions
+	var outcomes []*tfe.TFPolicySetOutcome
+
+	for {
+		page, err := b.client.TFPolicyEvaluationOutcomes.List(ctx, evaluationID, options)
+		if err != nil {
+			return nil, err
+		}
+		if page == nil {
+			return outcomes, nil
+		}
+		outcomes = append(outcomes, page.Items...)
+
+		if page.Pagination == nil || page.NextPage == 0 || page.NextPage == page.CurrentPage {
+			return outcomes, nil
+		}
+		if options == nil {
+			options = &tfe.TFPolicyEvaluationListOptions{}
+		}
+		options.PageNumber = page.NextPage
+	}
