+// so retaining every item is necessary for both rendering and summary counts.
+func (b *Cloud) readTFPolicyEvaluationOutcomes(ctx context.Context, evaluationID string) ([]*tfe.TFPolicySetOutcome, error) {
+	var options *tfe.TFPolicyEvaluationListOptions
+	var sets []*tfe.TFPolicySetOutcome
+
+	for {
+		list, err := b.client.TFPolicyEvaluationOutcomes.List(ctx, evaluationID, options)
+		if err != nil {
+			return nil, err
+		}
+		if list == nil {
+			return sets, nil
+		}
+		sets = append(sets, list.Items...)
+
+		if list.Pagination == nil || list.CurrentPage >= list.TotalPages || list.NextPage == 0 {
+			return sets, nil
+		}
+		if options == nil {
+			options = &tfe.TFPolicyEvaluationListOptions{}
+		}
+		options.PageNumber = list.NextPage
+	}
