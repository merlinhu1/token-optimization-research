+) -> dict[str, object]:
+    """Evaluate templates, parse values, and apply modify operations."""
+    return {
+        field: _apply_modify_operation(
+            obj,
+            field,
+            operation,
+            model_cls._parse(field, obj.evaluate_template(templates[field])),
+        )
+        for field, operation in mods.items()
+    }
+
 
