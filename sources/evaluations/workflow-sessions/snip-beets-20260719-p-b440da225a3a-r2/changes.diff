+ModifyOperator: TypeAlias = Literal["+", "-"]
+
+
+@dataclass(frozen=True)
+class ModifyOperation:
+    """A parsed modify assignment."""
+
+    operator: ModifyOperator | None
+    value: str
+
+
+ModifyOperations: TypeAlias = dict[str, ModifyOperation]
+
+
+def _validate_modify_operations(
+    model_cls: type[library.LibModel], mods: ModifyOperations
+) -> None:
+    """Reject incremental operations for fields that are not lists."""
+    for field, operation in mods.items():
+        if (
+            operation.operator is not None
+            and model_cls._type(field).model_type is not list
+        ):
+            raise UserError(
+                f"field '{field}' does not support the "
+                f"'{operation.operator}=' operator"
+            )
+
+
+def _apply_modify_operation(
+    obj: library.LibModel,
+    field: str,
+    operation: ModifyOperation,
+    parsed_value: object,
+) -> object:
+    """Apply one parsed assignment to an object without storing it."""
+    if operation.operator is None:
+        return parsed_value
+
+    if not isinstance(parsed_value, list):
+        raise UserError(
+            f"field '{field}' did not parse as a list for the "
+            f"'{operation.operator}=' operator"
+        )
+
+    current_value = obj.get(field, [])
+    if not isinstance(current_value, list):
+        raise UserError(
+            f"field '{field}' does not contain a list for the "
+            f"'{operation.operator}=' operator"
+        )
+
+    if operation.operator == "+":
+        result = list(current_value)
+        for value in parsed_value:
+            if value not in result:
+                result.append(value)
+        return result
+
+    return [value for value in current_value if value not in parsed_value]
+
+
+def _parse_object_mods(
+    obj: library.LibModel,
+    model_cls: type[library.LibModel],
+    mods: ModifyOperations,
