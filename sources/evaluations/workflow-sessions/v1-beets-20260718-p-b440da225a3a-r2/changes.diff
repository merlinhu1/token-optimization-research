 from .utils import do_query
 
+ModifyOperator: TypeAlias = Literal["+=", "-="]
+
+
+@dataclass(frozen=True)
+class ModifyOperation:
+    """A parsed field assignment for the ``modify`` command."""
+
+    operator: ModifyOperator | None
+    value: str
+
+
+def _is_multi_value_field(model_cls, field: str) -> bool:
+    """Return whether ``field`` parses to a list on ``model_cls``."""
+    return model_cls._type(field).model_type is list
+
+
+def _validate_modifications(model_cls, mods: dict[str, ModifyOperation]):
+    """Validate operators before any matching object is changed."""
+    for field, operation in mods.items():
+        if operation.operator and not _is_multi_value_field(model_cls, field):
+            raise UserError(
+                f"field '{field}' does not support operator "
+                f"'{operation.operator}'"
+            )
+
+
+def _apply_modify_operation(
+    current: Any, parsed: Any, operation: ModifyOperation
+) -> Any:
+    """Apply one parsed operation to a current model value."""
+    if operation.operator is None:
+        return parsed
+
+    # Operator validity is checked before objects are modified. These checks
+    # keep the value transformation explicit and protect this helper if it is
+    # reused independently of ``_validate_modifications``.
+    if not isinstance(current, list) or not isinstance(parsed, list):
+        raise UserError(
+            f"field does not support operator '{operation.operator}'"
+        )
+
+    if operation.operator == "+=":
+        result = list(current)
+        for value in parsed:
+            if value not in result:
+                result.append(value)
+        return result
+
+    return [value for value in current if value not in parsed]
+
+
+def _parse_modify_value(model_cls, obj, field, operation, template):
+    """Evaluate and parse an assignment, then apply its operator."""
+    parsed = model_cls._parse(field, obj.evaluate_template(template))
+    if operation.operator is None:
+        return parsed
+    return _apply_modify_operation(obj.get(field, []), parsed, operation)
+
 
