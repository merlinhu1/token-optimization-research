+func (b *Cloud) tfPolicyEvaluationOutcomes(ctx context.Context, evaluationID string) ([]*tfe.TFPolicySetOutcome, error) {
+	var options *tfe.TFPolicyEvaluationListOptions
+	var sets []*tfe.TFPolicySetOutcome
+
+	for {
+		page, err := b.client.TFPolicyEvaluationOutcomes.List(ctx, evaluationID, options)
+		if err != nil {
+			return nil, err
+		}
+		if page == nil {
+			return sets, nil
+		}
+		sets = append(sets, page.Items...)
+
+		if page.Pagination == nil || page.CurrentPage >= page.TotalPages {
+			return sets, nil
+		}
+		// A malformed pagination response must not cause an infinite loop. If
+		// the server omits or repeats NextPage, the next sequential page is
+		// still unambiguous from the pagination metadata.
+		nextPage := page.NextPage
+		if nextPage <= page.CurrentPage {
+			nextPage = page.CurrentPage + 1
+		}
+		if options == nil {
+			options = &tfe.TFPolicyEvaluationListOptions{}
+		}
+		options.PageNumber = nextPage
+	}
