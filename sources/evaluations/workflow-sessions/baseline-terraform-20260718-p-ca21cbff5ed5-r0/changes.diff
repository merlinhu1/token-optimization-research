+// GetDeferredResourceInstanceAddrs returns the known deferred instance
+// addresses and partially-expanded deferred addresses for the given
+// configuration resource.
+func (d *Deferred) GetDeferredResourceInstanceAddrs(addr addrs.ConfigResource) (addrs.Set[addrs.AbsResourceInstance], []addrs.PartialExpandedResource) {
+	result := addrs.MakeSet[addrs.AbsResourceInstance]()
+	if !d.deferralAllowed {
+		return result, nil
+	}
+
+	d.mu.Lock()
+	defer d.mu.Unlock()
+
+	var instancesMap addrs.Map[addrs.ConfigResource, addrs.Map[addrs.AbsResourceInstance, *plans.DeferredResourceInstanceChange]]
+	var partialMap addrs.Map[addrs.ConfigResource, addrs.Map[addrs.PartialExpandedResource, *plans.DeferredResourceInstanceChange]]
+	switch addr.Resource.Mode {
+	case addrs.ManagedResourceMode:
+		instancesMap = d.resourceInstancesDeferred
+		partialMap = d.partialExpandedResourcesDeferred
+	case addrs.DataResourceMode:
+		instancesMap = d.dataSourceInstancesDeferred
+		partialMap = d.partialExpandedDataSourcesDeferred
+	case addrs.EphemeralResourceMode:
+		instancesMap = d.ephemeralResourceInstancesDeferred
+		partialMap = d.partialExpandedEphemeralResourceDeferred
+	default:
+		panic(fmt.Sprintf("unexpected resource mode %q for %s", addr.Resource.Mode, addr))
+	}
+
+	if instances, ok := instancesMap.GetOk(addr); ok {
+		for _, elem := range instances.Elems {
+			result.Add(elem.Key)
+		}
+	}
+	var partials []addrs.PartialExpandedResource
+	if partialInstances, ok := partialMap.GetOk(addr); ok {
+		partials = make([]addrs.PartialExpandedResource, 0, partialInstances.Len())
+		for _, elem := range partialInstances.Elems {
+			partials = append(partials, elem.Key)
+		}
+	}
+	return result, partials
+}
+
