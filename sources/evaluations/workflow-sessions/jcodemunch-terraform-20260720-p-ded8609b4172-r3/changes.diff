+// listTFPolicyEvaluationOutcomes retrieves all policy-set outcome pages for an
+// evaluation. The API's first page is returned when no pagination options are
+// supplied, so subsequent requests begin at the page reported by NextPage.
+func (b *Cloud) listTFPolicyEvaluationOutcomes(ctx context.Context, evaluationID string) ([]*tfe.TFPolicySetOutcome, error) {
+	var (
+		options *tfe.TFPolicyEvaluationListOptions
+		sets    []*tfe.TFPolicySetOutcome
+	)
+
+	for {
+		page, err := b.client.TFPolicyEvaluationOutcomes.List(ctx, evaluationID, options)
+		if err != nil {
+			return nil, err
+		}
+		if page == nil {
+			return sets, nil
+		}
+
+		sets = append(sets, page.Items...)
+		if page.Pagination == nil || page.NextPage == 0 {
+			return sets, nil
+		}
+
+		if options == nil {
+			options = &tfe.TFPolicyEvaluationListOptions{}
+		}
+		options.PageNumber = page.NextPage
+	}
