+
+
+ModifyOperator = Literal["+", "-"]
+
+
+@dataclass(frozen=True)
+class ModifyOperation:
+    """A modification as written on the command line.
+
+    ``operator`` is ``None`` for an ordinary replacement and otherwise
+    identifies an incremental update to a multi-value field.
+    """
+
+    operator: ModifyOperator | None
+    value: str
+
+
+def _validate_operations(
+    model_cls: type[library.LibModel], mods: Mapping[str, ModifyOperation]
+) -> None:
+    """Ensure every incremental operation targets a multi-value field."""
+    for field, modification in mods.items():
+        if modification.operator is None:
+            continue
+        if not isinstance(model_cls._type(field), types.DelimitedString):
+            operator = f"{modification.operator}="
+            raise UserError(
+                f"field '{field}' does not support the '{operator}' operator"
+            )
+
+
+def _updated_value(
+    current: Any, modification: ModifyOperation, parsed: Any
+) -> Any:
+    """Apply a parsed operation to a field's current value."""
+    if modification.operator is None:
+        return parsed
+
+    # Incremental operations have already been checked against the model's
+    # multi-value field types, so parsing and existing model access both yield
+    # lists here.
+    assert isinstance(current, list)
+    assert isinstance(parsed, list)
+    if modification.operator == "+":
+        updated = list(current)
+        for value in parsed:
+            if value not in updated:
+                updated.append(value)
+        return updated
+
+    return [value for value in current if value not in parsed]
+
+
+def _evaluate_operations(
+    model_cls: type[library.LibModel],
+    obj: library.LibModel,
+    mods: Mapping[str, ModifyOperation],
+    templates: Mapping[str, functemplate.Template],
+) -> dict[str, Any]:
+    """Evaluate templates and parse operations for one model object."""
+    evaluated: dict[str, Any] = {}
+    for field, modification in mods.items():
+        field_type = model_cls._type(field)
+        value = obj.evaluate_template(templates[field])
+        parsed = field_type.parse(value)
+        current = obj.get(field, field_type.null)
+        evaluated[field] = _updated_value(current, modification, parsed)
+    return evaluated
+
 
