+
+def _is_multi_value_field(model_cls: type[library.LibModel], field: str) -> bool:
+    """Return whether ``field`` is represented by a list in ``model_cls``."""
+    return model_cls._type(field).model_type is list
+
+
+def _validate_operations(
+    model_cls: type[library.LibModel], mods: dict[str, ModifyOperation]
+) -> None:
+    """Reject incremental operations on fields that cannot hold lists."""
+    for field, operation in mods.items():
+        if operation.operator and not _is_multi_value_field(model_cls, field):
+            raise UserError(
+                f"field '{field}' does not support the '{operation.operator}' "
+                "operator; it is not a multi-value field"
+            )
+
+
+def _apply_operation(
+    model_cls: type[library.LibModel],
+    obj: library.LibModel,
+    field: str,
+    operation: ModifyOperation,
+    value: str,
+) -> object:
+    """Parse and apply one assignment, returning a typed model value."""
+    parsed = model_cls._parse(field, value)
+    if operation.operator is None:
+        return parsed
+
+    # Operators have already been validated for the model class. Keep this
+    # check local as well so this function remains safe when used directly.
+    if not _is_multi_value_field(model_cls, field):
+        raise UserError(
