+			return nil, err
+		}
+		if page == nil {
+			break
+		}
+
+		outcomes = append(outcomes, page.Items...)
+		if page.Pagination == nil || page.NextPage == 0 ||
+			(page.TotalPages > 0 && page.CurrentPage >= page.TotalPages) ||
+			(options != nil && page.NextPage == options.PageNumber) {
+			break
+		}
+		if options == nil {
+			options = &tfe.TFPolicyEvaluationListOptions{}
+		}
+		options.PageNumber = page.NextPage
+	}
+
+	return outcomes, nil
