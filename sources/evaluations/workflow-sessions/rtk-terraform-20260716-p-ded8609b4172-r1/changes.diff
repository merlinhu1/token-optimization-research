+// tfPolicyEvaluationOutcomes retrieves all pages of policy-set outcomes for an
+// evaluation. The API returns a pagination object even when the final page is
+// empty, so page completion is determined from both the total-pages fields and
+// next-page value.
+func (b *Cloud) tfPolicyEvaluationOutcomes(ctx context.Context, evaluationID string) ([]*tfe.TFPolicySetOutcome, error) {
+	var options *tfe.TFPolicyEvaluationListOptions
+	var outcomes []*tfe.TFPolicySetOutcome
+
+	for {
+		page, err := b.client.TFPolicyEvaluationOutcomes.List(ctx, evaluationID, options)
+		if err != nil {
+			return nil, err
+		}
+		if page == nil {
+			return outcomes, nil
+		}
+
+		outcomes = append(outcomes, page.Items...)
+		if page.Pagination == nil {
+			return outcomes, nil
+		}
+		if page.Pagination.TotalPages > 0 && page.Pagination.CurrentPage >= page.Pagination.TotalPages {
+			return outcomes, nil
+		}
+		if page.Pagination.NextPage <= 0 {
+			return outcomes, nil
+		}
+
+		options = &tfe.TFPolicyEvaluationListOptions{
+			ListOptions: tfe.ListOptions{PageNumber: page.Pagination.NextPage},
+		}
+	}
