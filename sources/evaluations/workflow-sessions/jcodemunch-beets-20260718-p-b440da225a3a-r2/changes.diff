+    from collections.abc import Mapping, Sequence
+
+
+ModifyOperator: TypeAlias = Literal["+=", "-=", None]
+
+
+@dataclass(frozen=True)
+class ModifyOperation:
+    """A field assignment and its optional incremental operation."""
+
+    operator: ModifyOperator
+    value: str
+
+
+ModifyOperations: TypeAlias = dict[str, ModifyOperation]
+ModelClass: TypeAlias = type[library.Album] | type[library.Item]
+ModelObject: TypeAlias = library.Album | library.Item
+
+
+def _is_multi_value_field(model_cls: ModelClass, field: str) -> bool:
+    return model_cls._type(field).model_type is list
+
+
+def _validate_operations(model_cls: ModelClass, mods: ModifyOperations) -> None:
+    """Ensure incremental operations target list-valued fields."""
+    for field, operation in mods.items():
+        if operation.operator and not _is_multi_value_field(model_cls, field):
+            raise UserError(
+                f"field {field!r} does not support the {operation.operator} "
+                "operator"
+            )
+
+
+def _apply_operation(
+    obj: ModelObject,
+    model_cls: ModelClass,
+    operation: ModifyOperation,
+    field: str,
+    value: str | functemplate.Template,
+) -> Any:
+    """Parse and apply one operation, returning the value to assign."""
+    parsed = model_cls._parse(field, obj.evaluate_template(value))
+    if operation.operator is None:
+        return parsed
+
+    # Validation is done before querying or modifying objects. Keep this
+    # check here as well so this helper remains safe when called directly.
+    if not _is_multi_value_field(model_cls, field):
+        raise UserError(
+            f"field {field!r} does not support the {operation.operator} operator"
+        )
+
+    current = obj[field]
+    if operation.operator == "+=":
+        result = list(current)
+        result.extend(value for value in parsed if value not in result)
+        return result
+
+    return [value for value in current if value not in parsed]
+
+
+def _parse_operations(
+    obj: ModelObject,
+    model_cls: ModelClass,
+    mods: ModifyOperations,
+    templates: dict[str, functemplate.Template],
+) -> dict[str, Any]:
+    return {
+        field: _apply_operation(
+            obj, model_cls, operation, field, templates[field]
+        )
+        for field, operation in mods.items()
+    }
+
 
