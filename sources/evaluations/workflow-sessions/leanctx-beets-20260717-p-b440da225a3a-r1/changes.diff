 from .utils import do_query
 
+if TYPE_CHECKING:
+    from collections.abc import Mapping, Sequence
+
+
+ModifyOperator = Literal["+", "-"]
+
+
+@dataclass(frozen=True)
+class ModifyOperation:
+    """A parsed field assignment from the modify command."""
+
+    operator: ModifyOperator | None
+    value: str
+
+
+def _unsupported_operator_error(
+    field: str, operation: ModifyOperation
+) -> UserError:
+    operator = f"{operation.operator}="
+    return UserError(f"field {field!r} does not support operator {operator!r}")
+
+
+def _validate_modifications(
+    model_cls: type[library.Item] | type[library.Album],
+    mods: Mapping[str, ModifyOperation],
+) -> None:
+    """Ensure incremental operations are only used with list fields."""
+    for field, modification in mods.items():
+        if (
+            modification.operator is not None
+            and model_cls._type(field).model_type is not list
+        ):
+            raise _unsupported_operator_error(field, modification)
+
+
+def _apply_incremental_operation(
+    current: list[str], operation: ModifyOperation, values: list[str]
+) -> list[str]:
+    """Apply an already parsed incremental operation to a list field."""
+    if operation.operator == "+":
+        result = list(current)
+        for value in values:
+            if value not in result:
+                result.append(value)
+        return result
+
+    assert operation.operator == "-"
+    return [value for value in current if value not in values]
+
+
+def _parse_modifications(
+    obj: library.Item | library.Album,
+    model_cls: type[library.Item] | type[library.Album],
+    mods: Mapping[str, ModifyOperation],
+    templates: Mapping[str, functemplate.Template],
+) -> dict[str, Any]:
+    """Evaluate templates, parse values, and apply incremental operations."""
+    parsed_mods: dict[str, Any] = {}
+    for field, modification in mods.items():
+        parsed_value = model_cls._parse(
+            field, obj.evaluate_template(templates[field])
+        )
+        if modification.operator is None:
+            parsed_mods[field] = parsed_value
+            continue
+
+        if not isinstance(parsed_value, list):
+            # This should be prevented by _validate_modifications, but keep
+            # the application boundary safe for custom model types.
+            raise _unsupported_operator_error(field, modification)
+        current_value = obj.get(field, [])
+        if not isinstance(current_value, list):
+            current_value = []
+        parsed_mods[field] = _apply_incremental_operation(
+            current_value, modification, parsed_value
+        )
+
+    return parsed_mods
+
 
