+class ModifyOperation:
+    """A parsed command-line assignment before it is applied to an object."""
+
+    operator: ModifyOperator | None
+    value: str
+
+
+@dataclass(frozen=True)
+class ParsedModifyOperation:
+    """An assignment whose value has been parsed for a model field."""
+
+    operator: ModifyOperator | None
+    value: Any
+
+
+ModifyOperations: TypeAlias = Mapping[str, ModifyOperation]
+ParsedModifyOperations: TypeAlias = Mapping[str, ParsedModifyOperation]
+
+
+def _parse_modify_assignment(arg: str) -> tuple[str, ModifyOperation] | None:
+    """Parse an assignment argument, including its optional list operator."""
+    if "=" not in arg:
+        return None
+
+    key, value = arg.split("=", 1)
+    if ":" in key:
+        return None
+
+    operator: ModifyOperator | None = None
+    if key.endswith("+"):
+        operator = "+="
+        key = key[:-1]
+    elif key.endswith("-"):
+        operator = "-="
+        key = key[:-1]
+
+    return key, ModifyOperation(operator, value)
+
+
+def _validate_modify_operations(
+    model_cls: type[library.LibModel], mods: ModifyOperations
+) -> None:
+    """Ensure incremental operations target fields represented as lists."""
+    for field, operation in mods.items():
+        if (
+            operation.operator is not None
+            and model_cls._type(field).model_type is not list
+        ):
+            raise UserError(
+                f"field {field!r} does not support {operation.operator}"
+            )
+
+
+def _parse_modify_operations(
+    obj: library.LibModel,
+    model_cls: type[library.LibModel],
+    mods: ModifyOperations,
+    templates: Mapping[str, Any],
+) -> dict[str, ParsedModifyOperation]:
+    """Evaluate templates and parse assignment values for one object."""
+    return {
+        field: ParsedModifyOperation(
+            operation.operator,
+            model_cls._parse(field, obj.evaluate_template(templates[field])),
+        )
+        for field, operation in mods.items()
+    }
+
+
+def _apply_modify_operation(
+    obj: library.LibModel, field: str, operation: ParsedModifyOperation
+) -> None:
+    """Apply one parsed replacement or incremental list operation."""
+    if operation.operator is None:
+        obj[field] = operation.value
+        return
+
+    current = obj[field]
+    values = operation.value
+    if operation.operator == "+=":
+        updated = list(current)
+        for value in values:
+            if value not in updated:
+                updated.append(value)
+    else:
+        updated = [value for value in current if value not in values]
+    obj[field] = updated
+
 
