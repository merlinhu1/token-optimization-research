 from .utils import do_query
 
+ModifyOperator = Literal["+=", "-="]
+
+
+@dataclass(frozen=True)
+class ModifyOperation:
+    """A user-supplied field assignment before its value is parsed."""
+
+    operator: ModifyOperator | None
+    value: str
+
+
+@dataclass(frozen=True)
+class ParsedModifyOperation:
+    """A field assignment with a value parsed for a model field."""
+
+    operator: ModifyOperator | None
+    value: Any
+
+
+ModifyOperations = Mapping[str, ModifyOperation]
+ParsedModifyOperations = Mapping[str, ParsedModifyOperation]
+
+
+def _validate_modify_operations(
+    model_cls: type[library.LibModel], mods: ModifyOperations
+) -> None:
+    """Ensure incremental assignments target multi-value fields."""
+    for field, operation in mods.items():
+        if operation.operator is not None:
+            field_type = model_cls._type(field)
+            if field_type.model_type is not list:
+                raise UserError(
+                    f"field '{field}' does not support "
+                    f"{operation.operator} operator"
+                )
+
+
+def _parse_modify_operations(
+    obj: library.LibModel,
+    model_cls: type[library.LibModel],
+    mods: ModifyOperations,
+    templates: Mapping[str, functemplate.Template],
+) -> dict[str, ParsedModifyOperation]:
+    """Evaluate and parse assignments for one model object."""
+    return {
+        field: ParsedModifyOperation(
+            operation.operator,
+            model_cls._parse(field, obj.evaluate_template(templates[field])),
+        )
+        for field, operation in mods.items()
+    }
+
+
+def _apply_modify_operations(
+    obj: library.LibModel, mods: ParsedModifyOperations
+) -> None:
+    """Apply parsed assignments to one model object."""
+    for field, operation in mods.items():
+        if operation.operator is None:
+            obj[field] = operation.value
+            continue
+
+        current = obj[field]
+        values = operation.value
+        if operation.operator == "+=":
+            updated = list(current)
+            updated.extend(value for value in values if value not in updated)
+        else:
+            updated = [value for value in current if value not in values]
+        obj[field] = updated
+
 
