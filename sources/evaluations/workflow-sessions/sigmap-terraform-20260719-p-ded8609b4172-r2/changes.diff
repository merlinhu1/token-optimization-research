+// listAllTFPolicyEvaluationOutcomes returns every policy-set outcome for an
+// evaluation. The API returns a page of policy sets at a time, and the
+// pagination metadata is not included in the run response.
+func (b *Cloud) listAllTFPolicyEvaluationOutcomes(ctx context.Context, evaluationID string) ([]*tfe.TFPolicySetOutcome, error) {
+	var (
+		all     []*tfe.TFPolicySetOutcome
+		options *tfe.TFPolicyEvaluationListOptions
+	)
+
+	for {
+		page, err := b.client.TFPolicyEvaluationOutcomes.List(ctx, evaluationID, options)
+		if err != nil {
+			return nil, err
+		}
+		if page == nil {
+			return all, nil
+		}
+
+		all = append(all, page.Items...)
+		if page.Pagination == nil {
+			return all, nil
+		}
+
+		nextPage := page.NextPage
+		if nextPage == 0 {
+			if page.TotalPages == 0 || page.CurrentPage >= page.TotalPages {
+				return all, nil
+			}
+			nextPage = page.CurrentPage + 1
+		}
+		if nextPage == page.CurrentPage {
+			return all, nil
+		}
+
+		options = &tfe.TFPolicyEvaluationListOptions{
+			ListOptions: tfe.ListOptions{PageNumber: nextPage},
+		}
+	}
+}
