+		deferredAddr := change.Change.Addr
+		if deferredAddr.Equal(addr) {
+			return true
+		}
+
+		if deferredAddr.Resource.Key == addrs.WildcardKey {
+			return deferredAddr.PartialResource().MatchesInstance(addr)
+		}
+		for _, step := range deferredAddr.Module {
+			if step.InstanceKey == addrs.WildcardKey {
+				return deferredAddr.PartialResource().MatchesInstance(addr)
+			}
 		}
-		return cty.NilVal, fmt.Errorf("no data source found for %s", target)
