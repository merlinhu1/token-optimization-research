+// deferredPolicyCallbackResources returns the deferred instances belonging to
+// a configuration resource. A deferred change can use a wildcard address when
+// the instance or a containing module is only partially expanded.
+func deferredPolicyCallbackResources(addr addrs.ConfigResource, changes []*plans.DeferredResourceInstanceChange) []*plans.DeferredResourceInstanceChange {
+	var ret []*plans.DeferredResourceInstanceChange
+	for _, change := range changes {
+		if change == nil || change.Change == nil {
+			continue
+		}
+		if change.Change.Addr.ConfigResource().Equal(addr) {
+			ret = append(ret, change)
+		}
+	}
+	return ret
+}
+
+func policyCallbackResourceIsDeferred(addr addrs.AbsResourceInstance, deferred []*plans.DeferredResourceInstanceChange) bool {
