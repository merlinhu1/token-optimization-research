+// GetDeferredResourceInstanceValues returns the approximate values for all
+// deferred managed resource instances belonging to the given configuration
+// resource. This includes partially-expanded instances whose full addresses
+// are not known yet.
+func (d *Deferred) GetDeferredResourceInstanceValues(addr addrs.ConfigResource) []cty.Value {
+	if !d.deferralAllowed {
+		return nil
+	}
+
+	d.mu.Lock()
+	defer d.mu.Unlock()
+
+	var result []cty.Value
+	if instances, ok := d.resourceInstancesDeferred.GetOk(addr); ok {
+		for _, elem := range instances.Elems {
+			result = append(result, elem.Value.Change.After)
+		}
+	}
+	if partials, ok := d.partialExpandedResourcesDeferred.GetOk(addr); ok {
+		for _, elem := range partials.Elems {
+			result = append(result, elem.Value.Change.After)
+		}
+	}
+	return result
+}
