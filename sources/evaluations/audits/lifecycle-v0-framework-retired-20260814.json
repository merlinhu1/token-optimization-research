  "adjudication": {
    "summary": "Lifecycle V0 is retired as an evaluation framework. Its sessions are removed from the active corpus rather than retained as historical comparison evidence, because the generation's prompt design does not measure the quantity the repository exists to measure.",
    "distinct_faults": [
      {
        "id": "solution-directed-prompt-design",
        "level": "design",
        "applies_to": "all lifecycle-v0 generations (baseline-v2, baseline-v3, baseline-v4)",
        "description": "V0 prompts used Solution-directed task assistance: they prescribed target files, symbols, implementation steps, focused validation commands, and stop conditions to reduce trajectory variance (docs/evaluations/design/framework.md). The resulting trajectory is transcription of a prescribed recipe, not autonomous repository search and problem-solving.",
        "why_it_invalidates": "Context-reduction tools act on retrieval, exploration, and terminal output. A prompt that removes the need to search suppresses the very behavior under test, so a token delta measured under V0 is not attributable to a tool's effect on realistic agent work. This is a confound in the estimand, not a defect in any individual run."
      },
      {
        "id": "official-integration-parity",
        "level": "execution",
        "applies_to": "48 of the original 54 v0 treatment sessions, already deleted 2026-07-18 through 2026-07-20",
        "description": "Treatment profiles did not materialize the product's documented integration surface, or retained no operational proof that the MCP treatment was assigned.",
        "why_it_invalidates": "Adjudicated previously; see official-integration-parity-20260718.json. The sessions deleted under the present receipt survived that gate and are removed for the design fault above, not for this one.",
        "prior_receipts": [
          "sources/evaluations/audits/official-integration-parity-20260718.json",
          "sources/evaluations/audits/invalid-treatment-result-deletions-20260718.json",
          "sources/evaluations/audits/unproven-treatment-result-deletions-20260718.json"
        ]
      },
      {
        "id": "verifier-environment-contract",
        "level": "controller",
        "applies_to": "baseline-v3 Beets and Terraform lanes, corrected by baseline-v4",
        "description": "The V3 final-verifier wrapper did not export WORKFLOW_REPO, so Beets and Terraform reported 0/3 despite the same focused commands passing inside all six model turns.",
        "why_it_invalidates": "A controller defect, already corrected under new V4 task, qualification, pool, protocol, audit, and attempt identities. Recorded here so the V3-to-V4 transition is not mistaken for the design fault above."
      }
    ],
